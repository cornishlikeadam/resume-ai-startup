# Server-only persistent database. Set one backend, never both browser-side.
DATABASE_URL=
# Optional alternative: a restored InsForge project with server DB privileges.
INSFORGE_ENDPOINT=
INSFORGE_SECRET_KEY=
# At least 32 random characters. Never use the old project default.
JWT_SECRET=
APP_URL=http://127.0.0.1:5173
PORT=3001
# Used by the optional InsForge model gateway when available.
AI_MODEL=openai/gpt-4o-mini
